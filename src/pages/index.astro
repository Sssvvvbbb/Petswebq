                                <span class="mosaic-label">Nuestro Equipo Pets e Instalaciones</span>
                            </div>
                            <span class="sr-only">Nuestro equipo e instalaciones</span>
                        </div>
                        <div class="mosaic-item" data-gallery="urnas" role="button" tabindex="0" aria-label="Ver galería de ánforas y relicarios" style="cursor:pointer;">
