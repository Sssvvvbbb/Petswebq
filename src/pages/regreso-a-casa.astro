        </script>
        <script type="application/ld+json">
        {"@context":"https://schema.org","@type":"Service","serviceType":"Cremación y Servicios Funerarios para Mascotas","provider":{"@type":"LocalBusiness","name":"PetsAlCielo"},"areaServed":{"@type":"City","name":"Puerto Montt"},"hasOfferCatalog":{"@type":"OfferCatalog","name":"Servicios Funerarios para Mascotas","itemListElement":[{"@type":"Offer","itemOffered":{"@type":"Service","name":"Cremación Ecológica mediante Agua"}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Urnas Conmemorativas Personalizadas"}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Retiro a Domicilio"}}]}}
