                            <figcaption class="sr-only">Acompañamiento emocional</figcaption>
                        </div>
                        <div class="mosaic-item">
                            <div class="mosaic-fill mf-5" aria-hidden="true">🕊️</div>
                            <figcaption class="sr-only">Despedida digna</figcaption>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Instagram Feed -->
