---
// CSS: el de la página va antes que los componentes (las reglas de Menu mandan sobre él)
import '../styles/regreso-a-casa.css';
import MejoraProgresiva from '../components/MejoraProgresiva.astro';
import Menu from '../components/Menu.astro';
import TopBar from '../components/TopBar.astro';
import Footer from '../components/Footer.astro';
import HeroCarousel from '../components/HeroCarousel.astro';
---
    <!DOCTYPE html>
<html lang="es">
<head>
        <meta charset="UTF-8">
        <MejoraProgresiva scripts={1} />
        <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
        
        <!-- SEO Meta Tags -->
        <title>Servicio de Cremación Ecológica Para Mascotas en Puerto Montt</title>
        <meta name="description" content="Crematorio ecológico para mascotas en Puerto Montt. Cremación individual mediante agua, sin fuego. Urnas personalizadas y retiro a domicilio. Atención 24/7.">
        <meta name="keywords" content="crematorio mascotas puerto montt, funeraria mascotas chile, cremación ecológica mascotas, servicios funerarios mascotas, cremación verde agua, urnas mascotas, despedida mascotas, crematorio perros gatos">
