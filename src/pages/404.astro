---
// Página 404 (decisión del dueño, 2026-11-12): Cloudflare Pages la sirve, con código 404,
// en cualquier dirección que no existe (antes respondía la home con 200, también a fotos o
// videos que no existen). Usa los componentes de la FAQ. Todas las rutas son absolutas
// (/…): se sirve en direcciones de cualquier profundidad. noindex.
import '../styles/preguntas-frecuentes.css';
import MejoraProgresiva from '../components/MejoraProgresiva.astro';
import Menu from '../components/Menu.astro';
import TopBar from '../components/TopBar.astro';
import SvgDefs from '../components/SvgDefs.astro';
import Decoracion from '../components/Decoracion.astro';
import PieFinal from '../components/PieFinal.astro';
import PageHero from '../components/PageHero.astro';
import GoogleTag from '../components/GoogleTag.astro';
import Favicons from '../components/Favicons.astro';
// Corazón bajo los botones: el mismo trazo a pincel de la portada (inicio/Portada.astro,
// CORAZON y PASADAS_GRANDE), quieto y en morado, sin relleno.
const CORAZON = 'M101 58 C94 34 64 22 44 38 C20 57 26 92 52 120 C68 137 88 151 100 170 C111 151 131 137 148 120 C176 92 182 56 158 38 C138 23 108 30 98 66';
const PASADAS = [[12.75, 0.95, 0, 0], [3.3, 0.9, 6.3, -4.5], [2.7, 0.8, -6.75, 4.8], [1.8, 0.7, 3, 7.5]];
---
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <MejoraProgresiva scripts={1} />
<Favicons />
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta name="color-scheme" content="only light">
        <GoogleTag />
    <title>Página no encontrada | PetsAlCielo</title>
    <meta name="robots" content="noindex, follow">
    <link rel="preload" href="/Assets/Fonts/DMSans-VariableFont_opsz_wght-latin.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/Assets/Fonts/CormorantGaramond-VariableFont_wght-latin.woff2" as="font" type="font/woff2" crossorigin>
    <style is:inline>@font-face{font-family:'DM Sans';font-style:normal;font-weight:100 900;font-display:swap;src:url('/Assets/Fonts/DMSans-VariableFont_opsz_wght-latin.woff2') format('woff2')}@font-face{font-family:'Cormorant Garamond';font-style:normal;font-weight:300 700;font-display:swap;src:url('/Assets/Fonts/CormorantGaramond-VariableFont_wght-latin.woff2') format('woff2')}@font-face{font-family:'Cormorant Garamond';font-style:italic;font-weight:300 700;font-display:swap;src:url('/Assets/Fonts/CormorantGaramond-Italic-VariableFont_wght-latin.woff2') format('woff2')}</style>
</head>
<body>
    <SvgDefs />
    <Decoracion />
    <TopBar variant="faq" />
    <Menu />
    <PageHero titulo="¡Ups! Esta página <em>no existe</em>" lead="Lo sentimos, está en una página que no existe. Por favor, le invitamos a navegar a través de nuestro menú para llegar a la página que busca." />
    <main>
    <section class="section no-existe">
        <div class="container">
            <p>Muchas gracias, y disculpe las molestias.</p>
            <div class="no-existe-btns">
                <a href="/" class="btn btn-primary">Ir al inicio</a>
                <a href="/preguntas-frecuentes" class="btn btn-primary">Preguntas frecuentes</a>
                <a href="/testimonios" class="btn btn-primary">Testimonios</a>
            </div>
            <!-- Caja de alto cero: el corazón ocupa el espacio que ya había bajo los botones -->
            <div class="no-existe-corazon"><svg viewBox="0 0 200 190" aria-hidden="true"><defs><filter id="pincel-404" x="-20%" y="-20%" width="140%" height="140%"><feTurbulence type="fractalNoise" baseFrequency=".9" numOctaves="2" seed="3" result="ruido"/><feDisplacementMap in="SourceGraphic" in2="ruido" scale="3" xChannelSelector="R" yChannelSelector="G"/></filter></defs><g filter="url(#pincel-404)">{PASADAS.map(([w, o, dx, dy]) => <path d={CORAZON} transform={`translate(${dx} ${dy})`} stroke-width={w} opacity={o}/>)}</g></svg></div>
        </div>
    </section>
    </main>
    <PieFinal titulo={false} />
</body>
</html>
