---
// /admin: la administradora sube fotos a las galerías de la Biblioteca y al carrusel
// de /testimonios. Pensada para usarse sin saber nada técnico: íconos grandes, pocas
// palabras, y las fotos se ordenan arrastrándolas (manteniéndolas presionadas en el
// celular). Protegida con Cloudflare Access (código al correo); la API está en
// functions/api/admin/ y guarda cada cambio como un commit en main (ver CLAUDE.md,
// sección "/admin"). Sin índice en Google (noindex aquí y X-Robots-Tag en _headers),
// sin Google Analytics y con su propia CSP (permite WebAssembly para convertir a WebP).
import '../styles/admin.css';
---
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="robots" content="noindex, nofollow">
<meta name="theme-color" content="#f3e6f6">
<title>Fotos de Pets Al Cielo</title>
<link rel="icon" type="image/x-icon" href="/Assets/favicon.ico">
<link rel="icon" type="image/png" sizes="32x32" href="/Assets/favicon-32x32.png">
<link rel="apple-touch-icon" sizes="180x180" href="/Assets/apple-touch-icon.png">
</head>
<body>
<svg class="ad-sprite" aria-hidden="true" focusable="false"><defs>
<symbol id="i-mas" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/></symbol>
<symbol id="i-basura" viewBox="0 0 24 24"><path d="M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13M10 11v6M14 11v6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></symbol>
<symbol id="i-volver" viewBox="0 0 24 24"><path d="M9 14 4 9l5-5M4 9h10a6 6 0 0 1 0 12h-3" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></symbol>
<symbol id="i-mano" viewBox="0 0 24 24"><path d="M9 11V5a1.5 1.5 0 0 1 3 0v5m0-1V4a1.5 1.5 0 0 1 3 0v6m0-3a1.5 1.5 0 0 1 3 0v6c0 4-2.5 7-6.5 7-2.5 0-4-1-5.5-3l-3-4.5a1.5 1.5 0 0 1 2.5-1.7L9 14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></symbol>
<symbol id="i-arriba" viewBox="0 0 24 24"><path d="M12 19V5M6 11l6-6 6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></symbol>
<symbol id="i-abajo" viewBox="0 0 24 24"><path d="M12 5v14M6 13l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></symbol>
<symbol id="i-izq" viewBox="0 0 24 24"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></symbol>
<symbol id="i-der" viewBox="0 0 24 24"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></symbol>
<symbol id="i-cerrar" viewBox="0 0 24 24"><path d="M6 6l12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></symbol>
<symbol id="i-check" viewBox="0 0 24 24"><path d="m5 12.5 4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></symbol>
</defs></svg>

<header class="ad-cab">
<a class="ad-logo" href="/"><img src="/Assets/logo_para_web-360.webp" alt="Pets Al Cielo" width="180" height="180"></a>
<div class="ad-cab-txt"><h1>Fotos de <em>Pets Al Cielo</em></h1><p id="adCorreo"></p></div>
<a class="ad-ver" href="/" target="_blank" rel="noopener">Ver la página ↗</a>
<svg class="ad-ondas" viewBox="0 0 1440 40" preserveAspectRatio="none" aria-hidden="true"><path d="M0 22C240 4 480 4 720 20s480 18 720 2v18H0z" fill="#fcf9f2"/></svg>
</header>

<main class="ad-main">
<noscript><p class="ad-aviso ad-error">Esta página necesita JavaScript.</p></noscript>
<p id="adPrueba" class="ad-aviso ad-prueba" hidden><strong>Puede probar todo, pero la página real no cambia.</strong> Esto es una web de experimentación para próxima implementación.</p>
<p id="adCargando" class="ad-cargando"><span class="ad-giro" aria-hidden="true"></span> Cargando…</p>

<section class="ad-paso" id="adPaso1" aria-labelledby="adP1" hidden>
<h2 id="adP1"><span class="ad-num">1</span> ¿Dónde irá la foto?</h2>
<div class="ad-grupo"><h3>Página web principal, Biblioteca</h3><div id="adGalerias" class="ad-opciones"></div></div>
<div class="ad-grupo"><h3>Página de testimonios</h3><div id="adTestimonios" class="ad-opciones"></div></div>
</section>

<section class="ad-paso" id="adEditor" aria-labelledby="adP2" hidden>
<h2 id="adP2"><span class="ad-num">2</span> <span class="ad-emoji ad-emoji-titulo" id="adIcono" aria-hidden="true"></span> <span id="adTitulo"></span></h2>
<p class="ad-ayuda" id="adAyuda"></p>
<p id="adAviso" class="ad-aviso" role="status" aria-live="polite" hidden></p>
<label class="ad-zona" id="adZona" for="adArchivos">
<span class="ad-agregar"><svg aria-hidden="true"><use href="#i-mas"/></svg> Agregar fotos</span>
<span class="ad-zona-txt ad-solo-mouse">o suéltalas aquí</span>
<input type="file" id="adArchivos" accept="image/*" multiple>
</label>
<p class="ad-pista"><svg aria-hidden="true"><use href="#i-mano"/></svg> <span class="ad-solo-mouse">Arrastra una foto hacia arriba o hacia abajo para cambiarla de lugar.</span><span class="ad-solo-tactil">Mantén el dedo sobre una foto y muévela hacia arriba o hacia abajo para cambiarla de lugar.</span></p>
<ol id="adLista" class="ad-lista"></ol>
<div class="ad-barra">
<span id="adResumen" class="ad-resumen"></span>
<button type="button" id="adDescartar" class="ad-sec" disabled><svg aria-hidden="true"><use href="#i-volver"/></svg> Deshacer</button>
<button type="button" id="adGuardar" class="ad-pri" disabled><svg aria-hidden="true"><use href="#i-check"/></svg> <span id="adGuardarTxt">Guardar</span></button>
</div>
</section>
</main>

<div class="ad-previa" id="adClave" role="dialog" aria-modal="true" aria-labelledby="adClaveT" hidden>
<form class="ad-previa-caja ad-clave-caja" id="adClaveForm">
<div class="ad-previa-cab"><h2 id="adClaveT">Clave de prueba</h2></div>
<div class="ad-clave-cuerpo">
<label for="adClaveInput">Escriba la clave para guardar en el sitio de prueba.</label>
<input type="password" id="adClaveInput" autocomplete="off" required>
<p class="ad-error" id="adClaveError" hidden></p>
</div>
<div class="ad-previa-pie"><button type="button" class="ad-sec" id="adClaveCancelar">Cancelar</button><button type="submit" class="ad-pri">Entrar</button></div>
</form>
</div>

<div class="ad-previa" id="adPrevia" role="dialog" aria-modal="true" aria-labelledby="adPreviaT" hidden>
<div class="ad-previa-caja">
<div class="ad-previa-cab"><h2 id="adPreviaT" tabindex="-1"></h2><button type="button" class="ad-cerrar" id="adPreviaCerrar" aria-label="Cancelar y no agregar"><svg aria-hidden="true"><use href="#i-cerrar"/></svg></button></div>
<div class="ad-carrusel">
<button type="button" class="ad-flecha ad-izq" id="adPrev" aria-label="Foto anterior"><svg aria-hidden="true"><use href="#i-izq"/></svg></button>
<div class="ad-diapos" id="adDiapos"></div>
<button type="button" class="ad-flecha ad-der" id="adSig" aria-label="Foto siguiente"><svg aria-hidden="true"><use href="#i-der"/></svg></button>
</div>
<div class="ad-puntos" id="adPuntos" aria-hidden="true"></div>
<div class="ad-previa-pie">
<button type="button" class="ad-pri" id="adAlPrincipio"><svg aria-hidden="true"><use href="#i-arriba"/></svg> Subir al principio</button>
<button type="button" class="ad-pri ad-pri-verde" id="adAlFinal"><svg aria-hidden="true"><use href="#i-abajo"/></svg> Subir al final</button>
</div>
</div>
</div>

<script>
    import '../scripts/admin/panel';
</script>
</body>
</html>
