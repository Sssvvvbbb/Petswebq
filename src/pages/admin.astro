---
// /admin: la administradora sube fotos a las galerías de la Biblioteca y al carrusel
// de /testimonios. Pensada para usarse sin saber nada técnico: íconos grandes, pocas
// palabras, y las fotos se ordenan arrastrándolas (manteniéndolas presionadas en el
// celular). Protegida con Cloudflare Access (código al correo); la API está en
// functions/api/admin/ y guarda cada cambio como un commit en main (ver CLAUDE.md,
// sección "/admin"). Sin índice en Google (noindex aquí y X-Robots-Tag en _headers),
// sin Google Analytics y con su propia CSP (permite WebAssembly para convertir a WebP).
import '../styles/admin.css';
---
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="robots" content="noindex, nofollow">
<meta name="theme-color" content="#f3e6f6">
<title>Fotos de Pets Al Cielo</title>
<link rel="icon" type="image/x-icon" href="/Assets/favicon.ico">
<link rel="icon" type="image/png" sizes="32x32" href="/Assets/favicon-32x32.png">
<link rel="apple-touch-icon" sizes="180x180" href="/Assets/apple-touch-icon.png">
</head>
<body>
<svg class="ad-sprite" aria-hidden="true" focusable="false"><defs>
<symbol id="i-casa" viewBox="0 0 64 64"><path d="M14 29v23h36V29" fill="#eadffa"/><path d="M8 31 32 11l24 20M14 29v23h36V29" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M32 46c-6-4-9-7-9-10.5 0-2.6 2-4.5 4.5-4.5 1.9 0 3.5 1 4.5 2.6 1-1.6 2.6-2.6 4.5-2.6 2.5 0 4.5 1.9 4.5 4.5C41 39 38 42 32 46z" fill="#ee9fc2"/></symbol>
<symbol id="i-equipo" viewBox="0 0 64 64"><circle cx="22" cy="22" r="7" fill="#d9efe9" stroke="currentColor" stroke-width="3.5"/><circle cx="42" cy="22" r="7" fill="#eadffa" stroke="currentColor" stroke-width="3.5"/><path d="M9 50c0-8 6-14 13-14s13 6 13 14M29 50c0-8 6-14 13-14s13 6 13 14" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round"/><path d="M32 16c-3-2-4.5-3.6-4.5-5.4 0-1.4 1-2.4 2.3-2.4 1 0 1.8.5 2.2 1.3.5-.8 1.3-1.3 2.3-1.3 1.3 0 2.2 1 2.2 2.4 0 1.8-1.5 3.4-4.5 5.4z" fill="#ee9fc2"/></symbol>
<symbol id="i-anfora" viewBox="0 0 64 64"><path d="M25 14c0 5-9 9-9 21 0 11 7 17 16 17s16-6 16-17c0-12-9-16-9-21z" fill="#eadffa"/><path d="M23 14h18M25 14c0 5-9 9-9 21 0 11 7 17 16 17s16-6 16-17c0-12-9-16-9-21M24 56h16M29 8h6" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M32 41c-4-2.8-6-4.9-6-7.2 0-1.8 1.4-3.1 3.1-3.1 1.3 0 2.4.7 2.9 1.8.5-1.1 1.6-1.8 2.9-1.8 1.7 0 3.1 1.3 3.1 3.1 0 2.3-2 4.4-6 7.2z" fill="#ee9fc2"/></symbol>
<symbol id="i-relicario" viewBox="0 0 64 64"><path d="M18 6c0 13 6 20 14 20s14-7 14-20" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-dasharray="1 5"/><circle cx="32" cy="28" r="3" fill="none" stroke="currentColor" stroke-width="3"/><path d="M32 58C20 50 13 44 13 37c0-5 4-9 9-9 4 0 7.6 2.2 10 5.6C34.4 30.2 38 28 42 28c5 0 9 4 9 9 0 7-7 13-19 21z" fill="#eadffa" stroke="currentColor" stroke-width="3.5" stroke-linejoin="round"/><circle cx="32" cy="42" r="5" fill="#ee9fc2"/></symbol>
