---
// Variante "regreso" de HeroCarousel: markup literal tomado de regreso-a-casa.
---
<header class="carousel-wrap" id="inicio" aria-label="Bienvenida PetsAlCielo">

    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    <div class="orb orb-3"></div>
    <div class="orb orb-4"></div>

    <!-- Petals -->
    <div class="petals" aria-hidden="true" id="petalContainer"></div>

    <!-- Slide 1 -->
    <div class="carousel-slide slide-bg-1 active" role="tabpanel" aria-label="Diapositiva 1">
        <div class="hero-inner">
            <span class="hero-eyebrow">Puerto Montt · Región de Los Lagos</span>
            <h1 class="hero-title">
                Crematorio Ecológico <br>para <em>Mascotas</em>
            </h1>
            <p class="hero-sub">
                Una despedida digna, llena de amor y respeto.<br>
                Acompañamos a su familia en este momento con calidez y profesionalismo.
            </p>
            <div class="hero-actions">
                <a href="https://wa.me/56998461172?text=Hola%2C%20necesito%20informaci%C3%B3n%20sobre%20el%20servicio%20de%20cremaci%C3%B3n" target="_blank" rel="noopener" class="btn btn-primary" aria-label="Contactar por WhatsApp">Contactar Ahora</a>
                <a href="#servicios" class="btn btn-ghost">Ver Servicios</a>
            </div>
        </div>
    </div>

    <!-- Slide 2 -->
    <div class="carousel-slide slide-bg-2" role="tabpanel" aria-label="Diapositiva 2">
        <div class="hero-inner">
            <span class="hero-eyebrow">Tecnología Avalada · Universidad de Concepción</span>
            <h2 class="hero-title">
                Cremación <em>Ecológica</em><br>mediante Agua
            </h2>
            <p class="hero-sub">
                Hidrólisis alcalina: el proceso más respetuoso con el medio ambiente.<br>
                Sin fuego, sin humo — solo pureza y serenidad.
            </p>
            <div class="hero-actions">
                <a href="#proceso" class="btn btn-primary">Conocer el Proceso</a>
                <a href="#nosotros" class="btn btn-ghost">Sobre Nosotros</a>
            </div>
        </div>
    </div>

    <!-- Slide 3 -->
    <div class="carousel-slide slide-bg-3" role="tabpanel" aria-label="Diapositiva 3">
        <div class="hero-inner">
            <span class="hero-eyebrow" style="margin-top: 8px; display: inline-block;">Porque son Familia</span>
            <h2 class="hero-title">
                Un Adiós <em>Digno</em><br>para Quien Amaste
            </h2>
            <p class="hero-sub">
                Aquí destacar la diferencia estética (ética y buena) de preferir un adiós en agua que en fuego. Cremación individual, urnas conmemorativas personalizadas y retiro a domicilio dentro de Puerto Montt. Atención inmediata, siempre.
            </p>
            <div class="hero-actions">
                <a href="#servicios" class="btn btn-primary">Ver Servicios</a>
                <a href="https://wa.me/56998461172?text=Hola%2C%20quisiera%20hablar%20sobre%20sus%20servicios" target="_blank" rel="noopener" class="btn btn-ghost">Hablar con Nosotros</a>
            </div>
        </div>
    </div>

    <div class="carousel-dots" role="tablist" aria-label="Controles del carrusel">
        <button class="dot active" data-slide="0" aria-label="Diapositiva 1" role="tab"></button>
        <button class="dot" data-slide="1" aria-label="Diapositiva 2" role="tab"></button>
        <button class="dot" data-slide="2" aria-label="Diapositiva 3" role="tab"></button>
    </div>
</header>

<script>
    // Carrusel de la portada y pétalos.
    import '../../scripts/portada-simple';
</script>
