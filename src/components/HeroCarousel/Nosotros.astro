---
// Variante "nosotros" de HeroCarousel: markup literal tomado de nosotros.
---
<header class="carousel-wrap" id="inicio" aria-label="Bienvenida PetsAlCielo">

    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    <div class="orb orb-3"></div>
    <div class="orb orb-4"></div>

    <!-- Petals -->
    <div class="petals" aria-hidden="true" id="petalContainer"></div>

    <!-- Slide 1 -->
    <div class="carousel-slide slide-bg-1 active" role="tabpanel" aria-label="Diapositiva 1">
        <img src="/Assets/cremacion_en_puerto_montt_petsalcielo_header.webp" alt="" class="slide-photo slide-photo-desktop" aria-hidden="true">
        <img src="/Assets/imagen_hero_crematorio_puertomontt_llanquihue.webp" alt="" class="slide-photo slide-photo-mobile" aria-hidden="true">
        <div class="slide-overlay"></div>
        <div class="hero-inner">
            <h1 class="hero-title">
                Su compañero<br>de vida, siempre<br>en su corazón.
            </h1>
            <div class="hero-divider"></div>
            <p class="hero-sub">
                Cremación digna y respetuosa<br>para honrar su vida.
            </p>
            <div class="hero-actions">
                <a href="#servicios" class="btn btn-primary hero-btn">Conocer nuestros servicios ›</a>
            </div>
        </div>
    </div>

    <!-- Slide 2 -->
    <div class="carousel-slide slide-bg-2" role="tabpanel" aria-label="Diapositiva 2">
        <img src="/Assets/cremacion_en_puerto_montt_petsalcielo_header.webp" alt="" class="slide-photo slide-photo-desktop" aria-hidden="true">
        <img src="/Assets/imagen_hero_crematorio_puertomontt_llanquihue.webp" alt="" class="slide-photo slide-photo-mobile" aria-hidden="true">
        <div class="slide-overlay"></div>
        <div class="hero-inner">
            <h2 class="hero-title">
                Cremación ecológica<br>por agua, sin fuego,<br>sin humo.
            </h2>
            <div class="hero-divider"></div>
            <p class="hero-sub">
                El proceso más respetuoso con el medio ambiente.
            </p>
            <div class="hero-actions">
                <button data-abre-galeria="mariposas" class="btn btn-primary hero-btn">Conocer el Proceso ›</button>
                <a href="#nosotros" class="btn btn-ghost hero-btn">Sobre Nosotros</a>
            </div>
        </div>
    </div>

    <!-- Slide 3 -->
    <div class="carousel-slide slide-bg-3" role="tabpanel" aria-label="Diapositiva 3">
        <img src="/Assets/cremacion_en_puerto_montt_petsalcielo_header.webp" alt="" class="slide-photo slide-photo-desktop" aria-hidden="true">
        <img src="/Assets/imagen_hero_crematorio_puertomontt_llanquihue.webp" alt="" class="slide-photo slide-photo-mobile" aria-hidden="true">
        <div class="slide-overlay"></div>
        <div class="hero-inner">
            <h2 class="hero-title">
                Un adiós digno<br>para quienes<br>amamos.
            </h2>
            <div class="hero-divider"></div>
            <p class="hero-sub">
                Cremación individual SIEMPRE.<br>Respeto y dignidad en cada paso.
            </p>
            <div class="hero-actions">
                <a href="https://petsalcielo.cl/preguntas-frecuentes" class="btn btn-primary hero-btn">Preguntas frecuentes ›</a>
                <a href="https://wa.me/56998461172?text=Hola%2C%20quisiera%20hablar%20sobre%20sus%20servicios" data-wa="Hola%2C%20quisiera%20hablar%20sobre%20sus%20servicios" class="btn btn-ghost hero-btn">Hablar con nosotros</a>
            </div>
        </div>
    </div>

    <div class="carousel-dots" role="tablist" aria-label="Controles del carrusel">
        <button class="dot active" data-slide="0" aria-label="Diapositiva 1" role="tab"></button>
        <button class="dot" data-slide="1" aria-label="Diapositiva 2" role="tab"></button>
        <button class="dot" data-slide="2" aria-label="Diapositiva 3" role="tab"></button>
    </div>
</header>

<script>
    // Carrusel de la portada y pétalos.
    import '../../scripts/portada-simple';
</script>
