            <svg width="18" height="18" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <polygon points="32,8 6,30 58,30" fill="url(#tb-roof)"/>
                <rect x="12" y="29" width="40" height="26" rx="3" fill="url(#tb-wall)"/>
