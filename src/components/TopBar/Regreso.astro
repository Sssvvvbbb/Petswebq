---
import WhatsAppBarra from '../WhatsAppBarra.astro';
// Variante "regreso" de TopBar: markup literal tomado de regreso-a-casa.
---
<aside class="top-bar">
    <div class="top-bar-content" style="padding-left:0;padding-right:0;justify-content:space-between;align-items:center;display:flex;width:100%;">
        <a href="https://www.google.com/maps/place/Pets+al+Cielo/@-41.4129877,-72.8823701,17z/data=!3m1!4b1!4m6!3m5!1s0x96182f3840ce3759:0x52c61b1adf6e89fd!8m2!3d-41.4129877!4d-72.8823701!16s%2Fg%2F11xdssj818?entry=ttu&g_ep=EgoyMDI2MDUxMy4wIKXMDSoASAFQAw%3D%3D" target="_blank" rel="noopener" class="top-bar-item" aria-label="Ver ubicación en Google Maps" style="padding-left:0.5rem;">
            <span>📍</span>
            <span>La Vara, Puerto Montt</span>
        </a>
        <div style="display:flex;align-items:center;gap:0.8rem;flex:1;justify-content:center;">
            <span class="top-bar-item">
                <span>Disponibles 24 horas</span>
            </span>
        </div>
        <div style="display:flex;align-items:center;gap:0.5rem;padding-right:0.9rem;">
            <WhatsAppBarra />
            <a href="https://wa.me/56998461172?text=Hola%2C%20necesito%20informaci%C3%B3n%20sobre%20el%20servicio%20de%20cremaci%C3%B3n" target="_blank" rel="noopener" class="top-bar-item" itemprop="telephone" aria-label="WhatsApp">
                <span>+569 9846 1172</span>
            </a>
        </div>
    </div>
</aside>
