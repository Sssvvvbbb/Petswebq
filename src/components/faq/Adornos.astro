---
// Adornos sutiles a los costados de las preguntas (solo computador, desde 1200 px):
// una línea continua que dibuja un corazón y una patita, una rama de hojas pastel,
// un gatito dibujado a crayón, un corazón pequeño con su trazo y ondas suaves al pie. Son
// decorativos (aria-hidden) y no reciben clics. Su CSS está en preguntas-frecuentes.css.
// La rama se dibuja aquí (no usa #branch de la home) para que sea más fina y pálida.
// Hoja ancha con punta, base en (0,0) y punta en (58,0); el pecíolo sale del tallo.
const HOJA = 'M0 0C8-15 28-21 44-15C52-11 56-5 58 0C50 9 34 16 20 13C10 11 3 6 0 0Z';
// Tallo: dos curvas Bézier. Cada hoja nace en un punto exacto del tallo (t de 0 a 1 en su
// curva), con un pecíolo corto, inclinada respecto de la dirección del tallo en ese punto.
const TALLO = [[[6, 236], [40, 210], [70, 178], [100, 142]], [[100, 142], [128, 108], [154, 80], [190, 44]]];
const enTallo = (c: number, t: number) => {
  const [p0, p1, p2, p3] = TALLO[c], u = 1 - t;
  const pt = [0, 1].map(k => u ** 3 * p0[k] + 3 * u * u * t * p1[k] + 3 * u * t * t * p2[k] + t ** 3 * p3[k]);
  const d = [0, 1].map(k => 3 * u * u * (p1[k] - p0[k]) + 6 * u * t * (p2[k] - p1[k]) + 3 * t * t * (p3[k] - p2[k]));
  return { x: +pt[0].toFixed(1), y: +pt[1].toFixed(1), ang: Math.atan2(d[1], d[0]) * 180 / Math.PI };
};
const HOJAS = ([[0, .45, -1, 1], [0, .8, 1, 1.1], [1, .15, -1, 1.05], [1, .45, 1, .95], [1, .72, -1, .85], [1, 1, 0, .8]] as const)
  .map(([c, t, lado, s]) => { const p = enTallo(c, t); return { x: p.x, y: p.y, g: +(p.ang + lado * 52).toFixed(1), s }; });
