<script>
    // Los adornos van a una altura fija; si al filtrar la sección queda más corta, los que
    // ya no caben completos se desvanecen, y vuelven cuando la sección se alarga.
    const adornos = document.querySelector<HTMLElement>('.faq-adornos');
    const seccion = adornos?.parentElement;
    if (adornos && seccion && 'ResizeObserver' in window) {
        const piezas = Array.from(adornos.querySelectorAll<SVGSVGElement>('svg:not(.fa-onda)'));
        const revisar = () => {
            const alto = seccion.clientHeight - 140; // deja libre la zona de las ondas del pie
            for (const p of piezas) {
                const r = p.getBoundingClientRect(), base = adornos.getBoundingClientRect().top;
                p.classList.toggle('fuera', r.bottom - base > alto);
            }
        };
        new ResizeObserver(revisar).observe(seccion);
    }
</script>
