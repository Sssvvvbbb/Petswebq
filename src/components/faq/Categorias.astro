---
// Botones de filtro por categoría (data-cat = id del grupo en src/data/faq.ts);
// muestran solo el .faq-group con ese data-group (clase is-hidden en los demás).
import { GRUPOS_FAQ } from '../../data/faq';
const CORTOS: Record<string, string> = { proceso: 'El Proceso', garantias: 'Garantías', servicio: 'Servicio', 'Ánforas': 'Ánforas' };
---
<div class="faq-categories" role="group" aria-label="Filtrar preguntas por categoría">
<button type="button" class="cat-btn active" data-cat="all" aria-pressed="true"><svg class="ico" aria-hidden="true"><use href="#i-leaf"/></svg> Todas</button>
{GRUPOS_FAQ.map(g => <button type="button" class="cat-btn" data-cat={g.id} aria-pressed="false"><svg class="ico" aria-hidden="true"><use href={`#${g.icono}`}/></svg> {CORTOS[g.id] ?? g.titulo}</button>)}
</div>

<script>
    const botones = document.querySelectorAll<HTMLElement>('.cat-btn');
    const grupos = document.querySelectorAll<HTMLElement>('.faq-group');
    botones.forEach(btn => btn.addEventListener('click', () => {
        botones.forEach(b => { b.classList.toggle('active', b === btn); b.setAttribute('aria-pressed', String(b === btn)); });
        const cat = btn.dataset.cat;
        grupos.forEach(g => g.classList.toggle('is-hidden', cat !== 'all' && g.dataset.group !== cat));
    }));
</script>
