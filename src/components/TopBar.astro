---
// Barra superior (ubicación, horario/WhatsApp, Instagram).
// Cada variante conserva el HTML exacto de su grupo de páginas.
import Home from './TopBar/Home.astro';
import Nosotros from './TopBar/Nosotros.astro';
import Faq from './TopBar/Faq.astro';
import Regreso from './TopBar/Regreso.astro';

interface Props {
  variant: 'home' | 'nosotros' | 'faq' | 'regreso';
}
const { variant } = Astro.props;
---
{variant === 'home' && <Home />}
{variant === 'nosotros' && <Nosotros />}
{variant === 'faq' && <Faq />}
{variant === 'regreso' && <Regreso />}

<style is:global>
    /* Ícono de Instagram de la barra superior (antes onmouseover) */
    .ig-mini:hover { opacity: 0.75; }
</style>
