---
// Google tag (gtag.js) de Google Analytics. El snippet de configuración va en un
// script que empaqueta Astro (la CSP no permite scripts en línea).
import { GA_ID } from '../data/sitio';
---
<script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
<script>
    import { GA_ID } from '../data/sitio';
    const w = window as unknown as { dataLayer: unknown[] };
    w.dataLayer = w.dataLayer || [];
    // gtag.js necesita el objeto arguments, no un arreglo
    function gtag(..._: unknown[]) { w.dataLayer.push(arguments); }
    gtag('js', new Date());
    gtag('config', GA_ID);
</script>
