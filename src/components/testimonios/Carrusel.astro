---
// Carrusel de testimonios (9:16, imagen o video). Las diapositivas del HTML son el
// respaldo; el JS las reemplaza con /Assets/testimonios/testimonios.json (así se
// agregan testimonios sin tocar el código: subir el archivo a /Assets/testimonios/ y
// sumar una línea al JSON con type "video"|"image", src, mp4 (opcional), poster y alt).
// Videos: el HTML no lleva el archivo. Se ve la portada (data-poster, se asigna al
// mostrarse la diapositiva actual y la siguiente) y el <video> se crea al pulsar.
// En escritorio se ven dos diapositivas a la vez (la actual y la siguiente).
// Sin avance automático con movimiento reducido. Contenido principal: sin reveal.
import Hojas from './Hojas.astro';
const RESPALDO = [
    { tipo: 'image', src: '/Assets/testimonios/testimonio-01.webp', alt: 'Testimonio de Blacky' },
    { tipo: 'video', src: '/Assets/testimonios/testimonio-02.webm', poster: '/Assets/testimonios/testimonio-02-portada.webp', alt: 'Testimonio de Luna' },
    { tipo: 'video', src: '/Assets/testimonios/testimonio-03.webm', poster: '/Assets/testimonios/testimonio-03-portada.webp', alt: 'Testimonio Vicho' },
    { tipo: 'video', src: '/Assets/testimonios/testimonio-04.webm', poster: '/Assets/testimonios/testimonio-04-portada.webp', alt: 'Testimonio de Luffy' },
];
---
<section class="t-sec t-carr" id="carrusel-testimonios" aria-label="Carrusel de testimonios"><Hojas /><div class="t-wrap">
<div class="t-stage"><button type="button" class="t-arrow t-prev" id="tPrev" aria-label="Testimonio anterior">‹</button>
<div class="t-card" id="testiSlidesContainer">
{RESPALDO.map((t, i) => (
<div class={i === 0 ? 't-slide testi-slide active' : 't-slide testi-slide'} role="group" aria-roledescription="testimonio" aria-label={`Testimonio ${i + 1} de ${RESPALDO.length}`}>
{t.tipo === 'image'
    ? <img class="t-media testi-media" src={t.src} alt={t.alt} width="400" height="720" fetchpriority="high" decoding="async">
    : <a class="t-video testi-video" href={t.src} data-video={t.src} aria-label={`Reproducir: ${t.alt}`}><img class="t-media testi-media" data-poster={t.poster} alt={t.alt} width="400" height="711" decoding="async"><span class="t-play" aria-hidden="true"></span></a>}
</div>
))}
</div>
<button type="button" class="t-arrow t-next" id="tNext" aria-label="Testimonio siguiente">›</button></div>
<div class="t-dots" id="tDots" role="tablist" aria-label="Testimonios"></div></div></section>

<script>
    const MANIFEST = '/Assets/testimonios/testimonios.json';
    const container = document.getElementById('testiSlidesContainer');
    const prevBtn = document.getElementById('tPrev')!;
    const nextBtn = document.getElementById('tNext')!;
    const dotsEl = document.getElementById('tDots')!;
    const DELAY = 5500;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    // En escritorio se ven dos a la vez: la actual y la siguiente (clase "next").
    const doble = matchMedia('(min-width: 900px)');

    interface Item { type: string; src: string; mp4?: string; poster?: string; alt?: string }

    if (container) {
        let slides: HTMLElement[] = [], total = 0, current = 0;
        let timer: number | undefined;
        const vid = (i: number) => slides[(i + total) % total]?.querySelector('video');
        // Índices de las diapositivas a la vista (1 en el celular, 2 en escritorio).
        const visibles = () => (doble.matches && total > 1 ? [current, (current + 1) % total] : [current]);
        const stop = () => { clearTimeout(timer); timer = undefined; };
        function schedule() {
            stop();
            if (reduce || total < 2) return;
            // Un video en reproducción en cualquiera de las diapositivas a la vista detiene el avance.
            if (visibles().some(i => { const v = vid(i); return v && !v.paused && !v.ended; })) return;
            timer = window.setTimeout(() => show(current + 1), DELAY);
        }
        // Portada de un video: se carga solo cuando su diapositiva se muestra o es la siguiente.
        function portada(i: number) {
            const img = slides[(i + total) % total]?.querySelector<HTMLImageElement>('img[data-poster]:not([src])');
            if (img) img.src = img.dataset.poster!;
        }
        function show(n: number) {
            current = (n + total) % total;
            const vista = visibles();
            slides.forEach((s, i) => {
                const on = vista.includes(i);
                s.classList.toggle('active', i === current);
                s.classList.toggle('next', on && i !== current);
                s.setAttribute('aria-hidden', on ? 'false' : 'true');
                if (!on) s.querySelectorAll('video').forEach(v => { if (!v.paused) v.pause(); });
            });
            Array.from(dotsEl.children).forEach((b, i) => {
                b.classList.toggle('active', i === current);
                b.setAttribute('aria-selected', String(i === current));
            });
            portada(current); portada(current + 1);
            if (doble.matches) portada(current + 2);
            schedule();
        }
        // Al pulsar la portada se crea el <video> con su archivo y recién ahí se descarga.
        function reproducir(a: HTMLAnchorElement) {
            const sl = a.closest('.testi-slide');
            const img = a.querySelector('img');
            const v = document.createElement('video');
            v.className = 't-media testi-media';
            v.controls = true; v.playsInline = true; v.preload = 'auto';
            if (img) { v.poster = img.dataset.poster || img.src; v.setAttribute('aria-label', img.alt); }
            [[a.dataset.video, 'video/webm'], [a.dataset.mp4, 'video/mp4']].forEach(([src, type]) => {
                if (!src) return;
                const so = document.createElement('source'); so.src = src; so.type = type!; v.appendChild(so);
            });
            v.addEventListener('play', stop);
            const aLaVista = () => visibles().some(i => slides[i] === sl);
            v.addEventListener('pause', () => { if (!v.ended && aLaVista()) schedule(); });
            v.addEventListener('ended', () => { if (slides[current] === sl) show(current + 1); else if (aLaVista()) schedule(); });
            a.replaceWith(v);
            stop();
            v.play().catch(() => {});
        }
        container.addEventListener('click', e => {
            const a = (e.target as Element).closest<HTMLAnchorElement>('.testi-video');
            if (!a) return;
            e.preventDefault();
            reproducir(a);
        });
        function init() {
            stop();
            slides = Array.from(container!.querySelectorAll<HTMLElement>('.testi-slide'));
            total = slides.length;
            if (!total) return;
            prevBtn.hidden = nextBtn.hidden = total < 2;
            slides.forEach((sl, i) => sl.setAttribute('aria-label', `Testimonio ${i + 1} de ${total}`));
            dotsEl.replaceChildren(...slides.map((_, i) => {
                const b = document.createElement('button');
                b.type = 'button';
                b.setAttribute('role', 'tab');
                b.setAttribute('aria-label', `Ir al testimonio ${i + 1}`);
                b.addEventListener('click', () => show(i));
                return b;
            }));
            show(0);
        }
        function build(it: Item, i: number) {
            const sl = document.createElement('div');
            sl.className = 't-slide testi-slide';
            sl.setAttribute('role', 'group');
            sl.setAttribute('aria-roledescription', 'testimonio');
            const img = document.createElement('img');
            img.className = 't-media testi-media';
            img.alt = it.alt || '';
            img.decoding = 'async';
            if (it.type === 'video') {
                const a = document.createElement('a');
                a.className = 't-video testi-video';
                a.href = it.src;
                a.dataset.video = it.src;
                if (it.mp4) a.dataset.mp4 = it.mp4;
                a.setAttribute('aria-label', 'Reproducir: ' + (it.alt || 'testimonio en video'));
                if (it.poster) img.dataset.poster = it.poster;
                const play = document.createElement('span');
                play.className = 't-play';
                play.setAttribute('aria-hidden', 'true');
                a.append(img, play);
                sl.appendChild(a);
            } else {
                img.src = it.src;
                if (i === 0) img.fetchPriority = 'high'; else img.loading = 'lazy';
                sl.appendChild(img);
            }
            return sl;
        }
        doble.addEventListener('change', () => show(current));
        prevBtn.addEventListener('click', () => show(current - 1));
        nextBtn.addEventListener('click', () => show(current + 1));
        init();
        fetch(MANIFEST, { cache: 'no-cache' })
            .then(r => (r.ok ? r.json() : null))
            .then((list: Item[] | null) => {
                if (!Array.isArray(list)) return;
                const items = list.filter(it => it && it.src && (it.type === 'video' || it.type === 'image'));
                if (!items.length) return;
                // Si la primera foto del JSON es la misma del HTML, se conserva tal cual
                // (ya está cargada y visible): no se vuelve a crear ni a descargar.
                const primera = container.querySelector('.testi-slide img.testi-media');
                const conservar = items[0].type === 'image' && primera && primera.getAttribute('src') === items[0].src
                    ? primera.closest('.testi-slide') : null;
                container.textContent = '';
                items.forEach((it, i) => container.appendChild(i === 0 && conservar ? conservar : build(it, i)));
                init();
            })
            .catch(() => {});
    }
</script>
