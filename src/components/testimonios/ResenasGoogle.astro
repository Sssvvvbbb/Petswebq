---
// Reseñas de Google: a la izquierda, destacada, una reseña con fotos; al costado, un
// grupo de tres reseñas sin fotos (texto completo) que cambia junto con la destacada.
// El grupo k son las reseñas sin fotos 3k, 3k+1 y 3k+2 (en el orden de
// src/data/resenas.ts, vuelve al principio al llegar al final): ese orden alterna largas
// y cortas para que los grupos midan parecido. Todos los grupos están en la misma
// celda y el alto es el del más largo (testimonios.css), así nada se mueve al cambiar.
// Las flechas y los puntos recorren las reseñas con fotos.
// Citas textuales: no corregirles la redacción. Todo va en el HTML (sin JS se ven la
// primera con fotos y el primer grupo); el JS solo muestra y oculta.
import { RESENAS } from '../../data/resenas';
import TarjetaResena from './TarjetaResena.astro';
const conFotos = RESENAS.map((r, i) => (r.fotos.length ? i : -1)).filter(i => i >= 0);
const sinFotos = RESENAS.map((r, i) => (r.fotos.length ? -1 : i)).filter(i => i >= 0);
const grupos = conFotos.map((_, k) => [0, 1, 2].map(j => sinFotos[(3 * k + j) % sinFotos.length]));
const GOOGLE_RESENAS = 'https://search.google.com/local/reviews?placeid=ChIJWTfOQDgvGJYR_Ylu3xobxlI';
---
<section class="t-sec t-goo" id="resenas-google" aria-labelledby="google-reviews-heading"><div class="t-wrap t-wide">
<svg class="sprite" aria-hidden="true" focusable="false"><symbol id="logo-google" viewBox="0 0 24 24"><path fill="#4285F4" d="M22.5 12.2c0-.8-.1-1.5-.2-2.2H12v4.2h5.9a5 5 0 0 1-2.2 3.3v2.7h3.5c2.1-1.9 3.3-4.7 3.3-8z"/><path fill="#34A853" d="M12 23c3 0 5.5-1 7.2-2.7l-3.5-2.7c-1 .7-2.2 1-3.7 1a6.4 6.4 0 0 1-6-4.4H2.4v2.8A11 11 0 0 0 12 23z"/><path fill="#FBBC05" d="M6 14.2a6.6 6.6 0 0 1 0-4.4V7H2.4a11 11 0 0 0 0 10z"/><path fill="#EA4335" d="M12 5.6c1.6 0 3.1.6 4.2 1.7l3.1-3.1A11 11 0 0 0 2.4 7L6 9.8a6.4 6.4 0 0 1 6-4.2z"/></symbol></svg>
<div class="t-head reveal"><span class="t-tag">Opiniones verificadas</span>
<h2 id="google-reviews-heading" class="t-title">Reseñas de <span class="gword" aria-label="Google"><i>G</i><i>o</i><i>o</i><i>g</i><i>l</i><i>e</i></span></h2>
<p class="t-lead">Palabras de familias que nos dejaron su reseña en Google, publicadas con su autorización.</p></div>
<div class="g-grid reveal" id="gGrid" aria-roledescription="reseñas">
<div class="g-main" id="gMain">{conFotos.map((i, k) => <TarjetaResena r={RESENAS[i]} i={i} lugar="destacada" oculta={k > 0} />)}</div>
<div class="g-side" id="gSide">{grupos.map((g, k) => <div class="g-trio" hidden={k > 0}>{g.map(i => <TarjetaResena r={RESENAS[i]} i={i} lugar="lateral" />)}</div>)}</div>
</div>
<div class="g-ctrl"><button type="button" class="t-arrow g-arrow" id="gPrev" aria-label="Reseña anterior">‹</button><div class="t-dots" id="gDots"></div><button type="button" class="t-arrow g-arrow" id="gNext" aria-label="Reseña siguiente">›</button></div>
<a class="g-cta" href={GOOGLE_RESENAS} target="_blank" rel="noopener"><svg class="g-logo" aria-hidden="true"><use href="#logo-google"/></svg><span>Ver más reseñas en Google</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
</div></section>

<script>
    // Muestra una reseña con fotos en #gMain y, en #gSide, su grupo de tres reseñas sin
    // fotos. No avanza solo (decisión del dueño, 2026-11-12): cambia con las flechas o los puntos.
    const grid = document.getElementById('gGrid');
    const principal = document.getElementById('gMain');
    const lado = document.getElementById('gSide');
    const puntos = document.getElementById('gDots');

    if (grid && principal && lado && puntos) {
        const grandes = Array.from(principal.querySelectorAll<HTMLElement>('.g-card'));
        const grupos = Array.from(lado.querySelectorAll<HTMLElement>('.g-trio'));
        let actual = 0; // posición en grandes

        function ubicar() {
            grandes.forEach((t, k) => { t.hidden = k !== actual; });
            grupos.forEach((g, k) => { g.hidden = k !== actual; });
            Array.from(puntos!.children).forEach((b, k) => b.classList.toggle('active', k === actual));
        }
        const ir = (k: number) => { actual = (k + grandes.length) % grandes.length; ubicar(); };

        puntos.replaceChildren(...grandes.map((g, k) => {
            const b = document.createElement('button');
            b.type = 'button';
            b.setAttribute('aria-label', `Ver la reseña de ${g.querySelector('.g-name')!.textContent}`);
            b.addEventListener('click', () => ir(k));
            return b;
        }));
        document.getElementById('gNext')!.addEventListener('click', () => ir(actual + 1));
        document.getElementById('gPrev')!.addEventListener('click', () => ir(actual - 1));
        ubicar();
    }

    // Fotos de la destacada: la caja ocupa el espacio libre de la tarjeta y las fotos se
    // reparten en filas justificadas al ancho (en su orden: todas en una fila, una arriba y
    // dos abajo, etc.). Se elige el reparto que las muestra más grandes y menos recortadas
    // (llenar la caja pesa más que un recorte moderado); si caben enteras no se estiran y
    // quedan centradas en el alto libre. Sin JS quedan en la grilla de alto fijo del CSS.
    const cajas = Array.from(document.querySelectorAll<HTMLElement>('#gMain .g-photos'));
    function repartos(n: number): number[][] {
        if (n === 0) return [[]];
        const todos: number[][] = [];
        for (let k = 1; k <= n; k++) for (const resto of repartos(n - k)) todos.push([k, ...resto]);
        return todos;
    }
    function acomodar(caja: HTMLElement) {
        const fotos = Array.from(caja.querySelectorAll('img'));
        const prop = fotos.map(f => +f.getAttribute('width')! / +f.getAttribute('height')! || 1);
        const ancho = caja.clientWidth, alto = caja.clientHeight;
        const hueco = parseFloat(getComputedStyle(document.documentElement).fontSize) * 0.6;
        if (!ancho || !alto) return;
        let mejor: { filas: number[][]; altos: number[]; escala: number } | null = null, puntaje = -1;
        for (const reparto of repartos(fotos.length)) {
            let i = 0;
            const filas = reparto.map(k => Array.from({ length: k }, () => i++));
            // alto de cada fila para que sus fotos, enteras, llenen el ancho
            const altos = filas.map(f => (ancho - (f.length - 1) * hueco) / f.reduce((s, j) => s + prop[j], 0));
            const natural = altos.reduce((s, h) => s + h, 0), libre = alto - (filas.length - 1) * hueco;
            if (libre <= 0) continue;
            // escala < 1: no caben enteras y se recortan arriba y abajo
            const escala = Math.min(1, libre / natural);
            const p = ancho * natural * escala * Math.sqrt(escala);
            if (p > puntaje) { puntaje = p; mejor = { filas, altos, escala }; }
        }
        if (!mejor) return;
        const usado = mejor.altos.reduce((s, h) => s + h, 0) * mejor.escala + (mejor.filas.length - 1) * hueco;
        let y = Math.max(0, (alto - usado) / 2);
        mejor.filas.forEach((fila, n) => {
            const h = mejor!.altos[n] * mejor!.escala, suma = fila.reduce((s, j) => s + prop[j], 0);
            let x = 0;
            for (const j of fila) {
                const w = (ancho - (fila.length - 1) * hueco) * prop[j] / suma;
                Object.assign(fotos[j].style, { left: x + 'px', top: y + 'px', width: w + 'px', height: h + 'px' });
                x += w + hueco;
            }
            y += h + hueco;
        });
    }
    if (cajas.length && 'ResizeObserver' in window) {
        const observador = new ResizeObserver(cambios => cambios.forEach(c => acomodar(c.target as HTMLElement)));
        cajas.forEach(c => { c.classList.add('g-justif'); observador.observe(c); });
    }
</script>
