---
// Reseñas de Google: una destacada (con sus fotos) y tres al costado; las flechas,
// los puntos o un clic en una reseña lateral cambian la destacada. Los datos están
// en src/data/resenas.ts (citas textuales: no corregirles la redacción).
// Todas las reseñas van en el HTML ya ubicadas (sin JS se ven la destacada y las
// tres laterales); el JS solo las cambia de lugar.
import { RESENAS } from '../../data/resenas';
import TarjetaResena from './TarjetaResena.astro';
const GOOGLE_RESENAS = 'https://search.google.com/local/reviews?placeid=ChIJWTfOQDgvGJYR_Ylu3xobxlI';
---
<section class="t-sec t-goo" id="resenas-google" aria-labelledby="google-reviews-heading"><div class="t-wrap t-wide">
<svg class="sprite" aria-hidden="true" focusable="false"><symbol id="logo-google" viewBox="0 0 24 24"><path fill="#4285F4" d="M22.5 12.2c0-.8-.1-1.5-.2-2.2H12v4.2h5.9a5 5 0 0 1-2.2 3.3v2.7h3.5c2.1-1.9 3.3-4.7 3.3-8z"/><path fill="#34A853" d="M12 23c3 0 5.5-1 7.2-2.7l-3.5-2.7c-1 .7-2.2 1-3.7 1a6.4 6.4 0 0 1-6-4.4H2.4v2.8A11 11 0 0 0 12 23z"/><path fill="#FBBC05" d="M6 14.2a6.6 6.6 0 0 1 0-4.4V7H2.4a11 11 0 0 0 0 10z"/><path fill="#EA4335" d="M12 5.6c1.6 0 3.1.6 4.2 1.7l3.1-3.1A11 11 0 0 0 2.4 7L6 9.8a6.4 6.4 0 0 1 6-4.2z"/></symbol></svg>
<div class="t-head reveal"><span class="t-tag">Opiniones verificadas</span>
<h2 id="google-reviews-heading" class="t-title">Reseñas de <span class="gword" aria-label="Google"><i>G</i><i>o</i><i>o</i><i>g</i><i>l</i><i>e</i></span></h2>
<p class="t-lead">Palabras de familias que nos dejaron su reseña en Google, publicadas con su autorización.</p></div>
<div class="g-grid reveal" id="gGrid" aria-roledescription="reseñas">
<div class="g-main" id="gMain"><TarjetaResena r={RESENAS[0]} i={0} lugar="destacada" /></div>
<div class="g-side" id="gSide">{RESENAS.slice(1, 4).map((r, k) => <TarjetaResena r={r} i={k + 1} lugar="lateral" />)}</div>
<div id="gResto" hidden>{RESENAS.slice(4).map((r, k) => <TarjetaResena r={r} i={k + 4} lugar="oculta" />)}</div>
</div>
<div class="g-ctrl"><button type="button" class="t-arrow g-arrow" id="gPrev" aria-label="Reseña anterior">‹</button><div class="t-dots" id="gDots"></div><button type="button" class="t-arrow g-arrow" id="gNext" aria-label="Reseña siguiente">›</button></div>
<a class="g-cta" href={GOOGLE_RESENAS} target="_blank" rel="noopener"><svg class="g-logo" aria-hidden="true"><use href="#logo-google"/></svg><span>Ver más reseñas en Google</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
</div></section>

<script>
    // Ubica las reseñas: la primera del orden en #gMain (destacada), las tres
    // siguientes en #gSide (botones) y el resto ocultas en #gResto. Sin avance
    // automático con movimiento reducido; se detiene con el mouse encima.
    const grid = document.getElementById('gGrid');
    const principal = document.getElementById('gMain');
    const lado = document.getElementById('gSide');
    const resto = document.getElementById('gResto');
    const puntos = document.getElementById('gDots');

    if (grid && principal && lado && resto && puntos) {
        const tarjetas = Array.from(grid.querySelectorAll<HTMLElement>('.g-card'));
        const orden = tarjetas.map((_, i) => i);
        const quieto = matchMedia('(prefers-reduced-motion: reduce)').matches;
        let temporizador: number | undefined;

        function ubicar() {
            orden.forEach((i, k) => {
                const t = tarjetas[i];
                const destacada = k === 0, lateral = k > 0 && k < 4;
                t.classList.toggle('g-big', destacada);
                if (lateral) {
                    t.tabIndex = 0;
                    t.setAttribute('role', 'button');
                    t.setAttribute('aria-label', `Ver la reseña de ${t.querySelector('.g-name')!.textContent}`);
                } else {
                    t.removeAttribute('tabindex');
                    t.removeAttribute('role');
                    t.setAttribute('aria-label', `Reseña de ${t.querySelector('.g-name')!.textContent}`);
                }
                (destacada ? principal : lateral ? lado : resto)!.appendChild(t);
            });
            Array.from(puntos!.children).forEach((b, i) => b.classList.toggle('active', i === orden[0]));
        }
        const siguiente = () => { orden.push(orden.shift()!); ubicar(); };
        const anterior = () => { orden.unshift(orden.pop()!); ubicar(); };
        function ir(i: number) { while (orden[0] !== i) orden.push(orden.shift()!); ubicar(); }
        function avanzar() {
            clearInterval(temporizador);
            if (!quieto) temporizador = window.setInterval(siguiente, 9000);
        }

        puntos.replaceChildren(...tarjetas.map((_, i) => {
            const b = document.createElement('button');
            b.type = 'button';
            b.setAttribute('aria-label', `Ver la reseña ${i + 1}`);
            b.addEventListener('click', () => { ir(i); avanzar(); });
            return b;
        }));
        lado.addEventListener('click', e => {
            const t = (e.target as Element).closest<HTMLElement>('.g-card');
            if (t) { ir(+t.dataset.i!); avanzar(); }
        });
        lado.addEventListener('keydown', e => {
            if (e.key !== 'Enter' && e.key !== ' ') return;
            const t = (e.target as Element).closest<HTMLElement>('.g-card');
            if (t) { e.preventDefault(); ir(+t.dataset.i!); avanzar(); }
        });
        document.getElementById('gNext')!.addEventListener('click', () => { siguiente(); avanzar(); });
        document.getElementById('gPrev')!.addEventListener('click', () => { anterior(); avanzar(); });
        grid.addEventListener('mouseenter', () => clearInterval(temporizador));
        grid.addEventListener('mouseleave', avanzar);
        ubicar();
        avanzar();
    }
</script>
