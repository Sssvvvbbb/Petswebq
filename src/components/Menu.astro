---
// Menú del sitio, igual al de /testimonios: botón corazón (celular), menú
// lateral (drawer) y barra de navegación de escritorio, con sus estilos.
// Su CSS (src/styles/menu.css) va después del CSS de la página, así que sus reglas mandan:
// cada página importa su CSS antes que este componente.
// Su JS es src/scripts/menu.ts (abrir/cerrar el menú lateral, pegar la barra bajo
// la barra superior y ocultar ítems al bajar). Incluye además src/scripts/enlaces.ts
// (WhatsApp al azar y atajos a las galerías), común a todas las páginas.
import HeartButton from './HeartButton.astro';
import Drawer from './Drawer.astro';
import NavPrincipal from './NavPrincipal.astro';
import '../styles/menu.css';
---

<HeartButton />

<div class="drawer-overlay" id="drawerOverlay"></div>

<Drawer
    links={[
        { href: "/", label: "Inicio" },
        { href: "/preguntas-frecuentes", label: "Preguntas Frecuentes" },
        { href: "/testimonios", label: "Testimonios" },
        { href: "/#Biblioteca", label: "Biblioteca" },
        { href: "/#video", label: "Proceso Ecológico" },
        { href: "/#nosotros", label: "Nosotros" },
    ]}
    cta="aleatorio"
    logo={{ src: "/Assets/logo_para_web-360.webp", alt: "Logo de Pets Al Cielo crematorio en Puerto Montt", width: "180", height: "180" }}
    deco="Disponibles 24/7 · Puerto Montt"
/>

<NavPrincipal
    logoHref="/"
    corazon={{ href: "/", ariaLabel: "Ir a inicio" }}
    links={[
        { href: "/#Biblioteca", label: "Biblioteca" },
        { href: "/#video", label: "Proceso Ecológico" },
        { href: "/#nosotros", label: "Nosotros" },
        { href: "/testimonios", label: "Testimonios" },
    ]}
    cta="aleatorio"
/>

<script>
    import '../scripts/menu';
    import '../scripts/enlaces';
</script>
