---
// Sección #homenajes: carrusel de Instagram (2 publicaciones por vista en escritorio,
// 1 en el celular) que arma src/scripts/homenajes.ts con /instagram.json.
import Onda from './Onda.astro';
import { INSTAGRAM_URL } from '../../data/sitio';
---
<section class="section homenajes pg hw" id="homenajes" aria-label="Homenajes Instagram">
<div class="lav-l"><svg viewBox="0 0 150 190" aria-hidden="true"><use href="#ramo-lavanda"/></svg></div><div class="lav-r"><svg viewBox="0 0 150 190" aria-hidden="true"><use href="#ramo-lavanda"/></svg></div>
<div class="container" style="max-width:1100px">
<div class="section-header" style="margin-bottom:1rem"><span class="section-tag reveal">Homenajes</span><h2 class="section-title reveal" style="font-size:clamp(1.5rem,4.6vw,2.4rem);margin-bottom:.4rem">Estamos en <em style="color:#b45ec8">Instagram</em></h2><p class="section-lead reveal">Familias que despidieron a sus compañeros con amor.</p></div>
<div class="ig-top reveal"><a class="btn btn-primary" href="/testimonios">Testimonios</a><a class="btn btn-ghost" href={INSTAGRAM_URL} target="_blank" rel="noopener">Ver todos los homenajes</a></div>
<div class="igc" id="igc" aria-roledescription="carrusel" aria-label="Homenajes en Instagram"><button type="button" class="igc-a igc-p" aria-label="Publicaciones anteriores">‹</button><div class="igc-view"><div class="igc-track" id="igcTrack"></div></div><button type="button" class="igc-a igc-n" aria-label="Publicaciones siguientes">›</button><div class="igc-dots" id="igcDots"></div></div>
</div>
<Onda forma="b" capas={[['#fcf9f2', .22], ['#fcf9f2', .5], ['#fcf9f2', .85], ['#fcf9f2', 1]]} />
</section>

<script>
    import '../../scripts/homenajes';
</script>
