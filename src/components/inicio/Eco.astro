---
// Sección #eco: la eco-cremación con agua. Cada círculo abre su explicación y el
// botón, el video educativo, en el modal de Explicaciones (data-open).
import Onda from './Onda.astro';
---
<section class="eco pg hw" id="eco" aria-labelledby="eco-t">
<svg class="leaf-l" viewBox="0 0 220 260" aria-hidden="true"><use href="#branch" transform="translate(0 40)"/></svg>
<svg class="leaf-r" viewBox="0 0 220 260" aria-hidden="true"><use href="#branch" transform="translate(0 40) scale(.9)"/></svg>
<span class="eyebrow reveal">Un proceso más amable con el planeta</span>
<h2 id="eco-t" class="reveal">Eco-Cremación con Agua<em>Sin fuego.</em></h2>
<p class="lead reveal">La hidrólisis alcalina utiliza agua en lugar de combustión para una despedida respetuosa y con menor impacto ambiental.</p>
<ul class="eco-icons reveal">
<li><button type="button" class="eci" data-open="hidro"><i><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 1.8C8.2 7 5 10.6 5 14.6a7 7 0 0 0 14 0C19 10.6 15.8 7 12 1.8z" fill="#4fb6e0"/><path d="M8.2 13.2a4 4 0 0 1 2.2-3.6" fill="none" stroke="#fff" stroke-width="1.4" stroke-linecap="round" opacity=".85"/><circle cx="8.6" cy="16.6" r=".9" fill="#fff" opacity=".7"/></svg></i>Hidrólisis<br>Alcalina</button></li>
<li><button type="button" class="eci" data-open="fuego"><i><svg viewBox="0 0 36 32" aria-hidden="true"><defs><clipPath id="gcl"><circle cx="15" cy="15" r="13"/></clipPath></defs><circle cx="15" cy="15" r="13" fill="#3b8fcb"/><g clip-path="url(#gcl)"><path d="M3 21a13 13 0 0 0 24 0c-4 3-10 4-24 0z" fill="#2f78ae" opacity=".55"/><path d="M5 9c2-3.5 7-5 10-3.5 1.5 1 0 2.5-1.5 3.5-1.5 1.5 0 3-2 4.5-2 1-3.5 3.5-6 2.5-2.5-2.5-3-5.5-.5-7z" fill="#6aad4c"/><path d="M10 18c3-1 6 0 6 3 0 3.5-2.5 5.5-3.5 8-3-1.5-3.5-5-3.5-7.5 0-1.5.5-2.5 1-3.5z" fill="#6aad4c"/><path d="M18 5c3-1.5 6 0 7 2.5 2 1 4 .5 4.5 3 .5 2.5-2 3-3.5 5-1.5 2.5-1 5.5-3.5 7-2.5-1.5-3-4-3-6.5 0-2.5-2.5-3.5-2.5-6.5 0-2 .5-3.5 1-4.5z" fill="#6aad4c"/></g><path d="M27 31.5S19 27 19 21.4a4 4 0 0 1 8-1.6 4 4 0 0 1 8 1.6C35 27 27 31.5 27 31.5z" fill="#d7141c" stroke="#fff" stroke-width="1.2" stroke-linejoin="round"/></svg></i>Sin<br>combustión</button></li>
<li><button type="button" class="eci" data-open="impacto"><i><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 11.5C12 16 12.3 19.5 12 23" fill="none" stroke="#4f9d6e" stroke-width="1.3" stroke-linecap="round"/><path d="M12.1 18.5C9.5 18.8 7.2 17.5 6.4 14.8 9.2 14.6 11.4 15.9 12.1 18.5z" fill="#6fba88" stroke="#4f9d6e" stroke-width=".5" stroke-linejoin="round"/><path d="M12.1 16.2C14.5 16.3 16.6 15 17.4 12.6 14.8 12.4 12.8 13.8 12.1 16.2z" fill="#6fba88" stroke="#4f9d6e" stroke-width=".5" stroke-linejoin="round"/><g fill="#fff" stroke="#8fb8a3" stroke-width=".7">{[0, 45, 90, 135, 180, 225, 270, 315].map(g => <ellipse cx="12" cy="4.5" rx="1.6" ry="2.7" transform={`rotate(${g} 12 8.2)`}/>)}</g><circle cx="12" cy="8.2" r="2.2" fill="#f2b632" stroke="#d99a1c" stroke-width=".5"/></svg></i>Volver al ciclo<br>de la vida</button></li>
</ul>
<button type="button" class="btn btn-eco reveal" data-open="video">Tenemos un video educativo</button>
<p class="eco-nota reveal">También puede presionar en el círculo para leer la explicación detallada</p>
<Onda forma="b" invertida capas={[['#fcf9f2', .22], ['#fcf9f2', .5], ['#fcf9f2', .85], ['#fcf9f2', 1]]} />
</section>
