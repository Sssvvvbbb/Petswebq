/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.instagram.com https://static.cdninstagram.com https://static.cloudflareinsights.com; connect-src 'self'; img-src 'self' data: https://*.cdninstagram.com https://*.fbcdn.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; frame-src https://www.instagram.com https://www.youtube.com https://www.youtube-nocookie.com;

# Archivos del build de Astro: llevan hash en el nombre, se pueden cachear para siempre.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Datos que cambian (feed de Instagram cada 12 h, galerías): sin caché larga.
/instagram.json
  Cache-Control: public, max-age=0, must-revalidate

/gallery/*
  Cache-Control: public, max-age=0, must-revalidate
