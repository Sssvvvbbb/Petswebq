                background: linear-gradient(160deg, rgba(168,230,214,0.5) 0%, rgba(203,174,242,0.4) 40%, rgba(238,165,233,0.4) 80%, rgba(183,240,245,0.5) 100%);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 6rem;
            }
            .about-badge {
                position: absolute;
                bottom: -1.5rem;
                right: -1.5rem;
                width: 160px;
                height: 160px;
                border-radius: 50%;
                background: linear-gradient(135deg, var(--mint) 0%, var(--lavender) 100%);
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                text-align: center;
                box-shadow: 0 12px 40px rgba(100,140,200,0.2);
                border: 4px solid white;
            }
            .about-badge span:first-child {
                font-family: 'Cormorant Garamond', serif;
                font-size: 2.4rem;
                font-weight: 600;
                color: var(--text-dark);
                line-height: 1;
            }
            .about-badge span:last-child {
                font-size: 0.7rem;
                color: var(--text-mid);
                font-weight: 400;
                max-width: 90px;
                text-align: center;
                line-height: 1.3;
            }
            .about-text p {
                font-size: 1rem;
                line-height: 1.9;
                color: var(--text-mid);
                font-weight: 300;
                margin-bottom: 1.2rem;
            }

            /* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
            PROCESO PASO A PASO - linea de tiempo horizontal
            ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
            .process-steps {
                display: grid;
                grid-template-columns: repeat(4, 1fr);
                gap: 2rem;
                position: relative;
            }
            .process-steps::before {
                content: '';
                position: absolute;
                top: 36px;
                left: 12%;
                right: 12%;
                height: 1px;
                background: linear-gradient(90deg, var(--mint), var(--lavender), var(--rose-a), var(--ice));
            }
            .process-step {
                text-align: center;
                position: relative;
            }
            .step-bubble {
                width: 72px;
                height: 72px;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 1.8rem;
                margin: 0 auto 1.5rem;
                position: relative;
                z-index: 1;
                border: 3px solid white;
                box-shadow: 0 6px 24px rgba(100,140,160,0.15);
            }
            .sb-1 { background: linear-gradient(135deg, rgba(168,230,214,0.7), rgba(108,210,245,0.5)); }
            .sb-2 { background: linear-gradient(135deg, rgba(203,174,242,0.7), rgba(162,233,215,0.5)); }
            .sb-3 { background: linear-gradient(135deg, rgba(238,165,233,0.7), rgba(203,174,242,0.5)); }
            .sb-4 { background: linear-gradient(135deg, rgba(240,201,130,0.7), rgba(244,145,143,0.5)); }
            .process-step h4 {
                font-family: 'Cormorant Garamond', serif;
                font-size: 1.15rem;
                font-weight: 500;
                color: var(--text-dark);
                margin-bottom: 0.6rem;
            }
            .process-step p {
                font-size: 0.88rem;
                color: var(--text-soft);
                line-height: 1.7;
                font-weight: 300;
            }

            /* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
            GALERIA MOSAICO - fotos de instalaciones
            ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
            .gallery-mosaic {
                display: grid;
                grid-template-columns: 1.5fr 1fr 1fr;
                grid-template-rows: 260px 260px;
                gap: 1rem;
                border-radius: 24px;
                overflow: hidden;
            }
            .mosaic-item {
                overflow: hidden;
                position: relative;
            }
            .mosaic-item:first-child {
                grid-row: 1 / 3;
            }
            .mosaic-fill {
                width: 100%;
                height: 100%;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 3.5rem;
                transition: transform 0.5s ease;
            }
            .mosaic-item:hover .mosaic-fill { transform: scale(1.05); }
            .mf-1 { background: linear-gradient(145deg, rgba(168,230,214,0.6), rgba(108,210,245,0.4)); }
            .mf-2 { background: linear-gradient(145deg, rgba(238,165,233,0.6), rgba(203,174,242,0.4)); }
            .mf-3 { background: linear-gradient(145deg, rgba(240,201,130,0.5), rgba(244,145,143,0.4)); }
            .mf-4 { background: linear-gradient(145deg, rgba(203,174,242,0.6), rgba(183,240,245,0.4)); }
            .mf-5 { background: linear-gradient(145deg, rgba(168,230,214,0.5), rgba(238,165,233,0.4)); }

            /* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
            SECCION VIDEO - explicacion del proceso ecologico
            ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
            .video-section {
                background: linear-gradient(160deg, rgba(41,167,152,0.06) 0%, rgba(203,174,242,0.08) 50%, rgba(238,165,233,0.06) 100%);
            }
            .video-frame {
                max-width: 900px;
                margin: 3rem auto 0;
                border-radius: 20px;
                overflow: hidden;
                box-shadow: 0 20px 80px rgba(41,167,152,0.2), 0 0 0 1px rgba(255,255,255,0.6);
            }
            .video-wrapper {
                position: relative;
                padding-bottom: 56.25%;
                height: 0;
            }
            .video-wrapper iframe {
                position: absolute;
                top: 0; left: 0;
                width: 100%; height: 100%;
            }

            /* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
            FRANJA DE ESTADISTICAS - numeros destacados
            ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
            .stats-strip {
                display: grid;
                grid-template-columns: repeat(4, 1fr);
                gap: 1px;
                background: rgba(168,230,214,0.2);
                border-radius: 20px;
                overflow: hidden;
                margin: 3rem 0;
            }
            .stat-item {
                background: rgba(255,255,255,0.7);
                padding: 2.5rem 2rem;
                text-align: center;
                backdrop-filter: blur(10px);
            }
            .stat-num {
                font-family: 'Cormorant Garamond', serif;
                font-size: 3rem;
                font-weight: 400;
                background: linear-gradient(135deg, var(--teal), var(--lavender));
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
                background-clip: text;
                line-height: 1;
                margin-bottom: 0.5rem;
            }
            .stat-label {
                font-size: 0.82rem;
                color: var(--text-soft);
                letter-spacing: 0.08em;
                text-transform: uppercase;
            }

            /* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
            LLAMADA A LA ACCION - seccion de cierre con botones
            ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
            .cta-section {
                position: relative;
                overflow: hidden;
                text-align: center;
                padding: clamp(4rem, 8vw, 7rem) 2rem;
            }
            .cta-section::before {
                content: '';
                position: absolute;
                inset: 0;
                background: linear-gradient(160deg,
                    rgba(168,230,214,0.35) 0%,
                    rgba(203,174,242,0.3) 35%,
                    rgba(238,165,233,0.25) 65%,
                    rgba(183,240,245,0.3) 100%);
                z-index: 0;
            }
            .cta-orb-1 {
                position: absolute;
                width: 500px; height: 500px;
                border-radius: 50%;
                background: radial-gradient(circle, rgba(41,167,152,0.15), transparent);
                filter: blur(60px);
                top: -150px; left: -150px;
            }
            .cta-orb-2 {
                position: absolute;
                width: 400px; height: 400px;
                border-radius: 50%;
                background: radial-gradient(circle, rgba(238,165,233,0.2), transparent);
                filter: blur(60px);
                bottom: -100px; right: -100px;
            }
            .cta-inner {
                position: relative;
                z-index: 1;
                max-width: 720px;
                margin: 0 auto;
            }
            .cta-inner .section-title { margin-bottom: 1rem; }
            .cta-inner p {
                font-size: 1.1rem;
                color: var(--text-mid);
                line-height: 1.8;
                margin-bottom: 2.5rem;
                font-weight: 300;
            }

            /* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
            BARRA DE CONTACTO - telefono, whatsapp y direccion
            ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
            .contact-bar {
                background: rgba(255,255,255,0.7);
                border-top: 1px solid rgba(168,230,214,0.3);
                padding: 3.5rem 0;
                backdrop-filter: blur(10px);
            }
            .contact-grid {
                display: flex;
                justify-content: center;
                align-items: flex-start;
                gap: 5rem;
                flex-wrap: wrap;
            }
            .contact-item { text-align: center; display: flex; flex-direction: column; align-items: center; }
            .contact-icon {
                width: 44px; height: 44px;
                border-radius: 14px;
                background: linear-gradient(135deg, rgba(168,230,214,0.4), rgba(108,210,245,0.3));
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 1.2rem;
                margin: 0 auto 0.8rem;
            }
            .contact-label {
                font-size: 0.75rem;
                letter-spacing: 0.1em;
                text-transform: uppercase;
                color: var(--text-soft);
                margin-bottom: 0.3rem;
            }
            .contact-value {
                font-family: 'DM Sans', sans-serif;
                font-size: 1.05rem;
                font-weight: 300;
                color: var(--text-dark);
            }
            .contact-value a {
                color: inherit;
                text-decoration: none;
                transition: color 0.2s;
                font-family: 'DM Sans', sans-serif;
                font-size: inherit;
                font-weight: inherit;
            }
            .contact-value a:hover { color: var(--teal); }

            /* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
            PIE DE PAGINA - links, redes y derechos
            ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
            footer {
                background: linear-gradient(160deg, #2d4a44 0%, #1e3830 100%);
                color: rgba(255,255,255,0.75);
                padding: 4rem 2rem 2rem;
            }
            .footer-grid {
                max-width: 1360px;
                margin: 0 auto;
                display: grid;
                grid-template-columns: 2fr 1fr 1fr 1fr;
                gap: 3rem;
                margin-bottom: 3rem;
            }
            .footer-logo {
                font-family: 'Cormorant Garamond', serif;
                font-size: 2rem;
                font-weight: 400;
                color: white;
                margin-bottom: 1rem;
            }
            .footer-logo em {
                font-style: italic;
                color: var(--mint);
            }
            .footer-col p, .footer-col ul {
                font-size: 0.88rem;
                line-height: 1.9;
                font-weight: 300;
            }
            .footer-col h4 {
                font-size: 0.75rem;
                letter-spacing: 0.15em;
                text-transform: uppercase;
                color: rgba(255,255,255,0.5);
                margin-bottom: 1.2rem;
                font-weight: 500;
            }
            .footer-col ul { list-style: none; }
            .footer-col ul li { margin-bottom: 0.6rem; }
            .footer-col a {
                color: rgba(255,255,255,0.65);
                text-decoration: none;
                transition: color 0.2s;
                font-size: 0.88rem;
            }
            .footer-col a:hover { color: var(--mint); }
            .footer-bottom {
                max-width: 1360px;
                margin: 0 auto;
                padding-top: 2rem;
                border-top: 1px solid rgba(255,255,255,0.1);
                text-align: center;
                font-size: 0.82rem;
                line-height: 1.8;
                color: rgba(255,255,255,0.45);
            }

            /* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
            DIVISOR DECORATIVO - linea entre secciones
            ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
            .divider {
                height: 1px;
                background: linear-gradient(90deg, transparent, rgba(168,230,214,0.4), rgba(203,174,242,0.4), transparent);
                margin: 0 2rem;
            }

            /* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
            ANIMACION DE ENTRADA - elementos aparecen al hacer scroll
            ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
            .reveal {
                opacity: 0;
                transform: translateY(28px);
                transition: opacity 0.7s ease, transform 0.7s ease;
            }
            .reveal.visible {
                opacity: 1;
                transform: translateY(0);
            }
            .reveal-delay-1 { transition-delay: 0.1s; }
            .reveal-delay-2 { transition-delay: 0.2s; }
            .reveal-delay-3 { transition-delay: 0.3s; }
            .reveal-delay-4 { transition-delay: 0.4s; }

            /* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
            ACCESIBILIDAD - clases para lectores de pantalla
            ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
            .sr-only {
                position: absolute;
                width: 1px; height: 1px;
                padding: 0; margin: -1px;
                overflow: hidden;
                clip: rect(0,0,0,0);
                white-space: nowrap;
                border-width: 0;
            }

            /* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
            ADAPTACION RESPONSIVE - tablet y celular
            ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
            @media (max-width: 1024px) {
                .services-bento { grid-template-columns: repeat(2, 1fr); }
                .about-split { grid-template-columns: 1fr; gap: 3rem; }
                .about-visual { max-width: 480px; margin: 0 auto; }
                .process-steps { grid-template-columns: repeat(2, 1fr); }
                .process-steps::before { display: none; }
                .stats-strip { grid-template-columns: repeat(2, 1fr); }
                .footer-grid { grid-template-columns: 1fr 1fr; }
            }
            @media (max-width: 768px) {
                .top-bar-content { padding-left: 0.75rem !important; padding-right: 0.75rem !important; }
                .carousel-wrap { height: 100svh; }
                /* Mantener position:absolute y fade en móvil — NO usar display:none */
                .carousel-slide {
                    position: absolute;
                    inset: 0;
                    padding-top: 68px; /* top-bar (~28px) + nav (~40px) en móvil */
                }
                .services-bento { grid-template-columns: 1fr; }
                .process-steps { grid-template-columns: repeat(2, 1fr); gap: 1rem; }
                .process-steps::before { display: none; }
                .step-bubble { width: 48px; height: 48px; font-size: 1.2rem; margin-bottom: 0.8rem; }
                .process-step { padding: 1.2rem 0.8rem !important; }
                .process-step h4 { font-size: 0.9rem; margin-bottom: 0.4rem; }
                .process-step p { font-size: 0.72rem; line-height: 1.5; }
                .gallery-mosaic {
                    grid-template-columns: 1fr 1fr;
                    grid-template-rows: auto;
                }
                .mosaic-item:first-child { grid-row: auto; }
                .stats-strip { grid-template-columns: 1fr 1fr; }
                .contact-grid { gap: 1.2rem; flex-wrap: nowrap; }
                .contact-icon { width: 36px; height: 36px; font-size: 1rem; border-radius: 10px; }
                .contact-label { font-size: 0.6rem; white-space: nowrap; }
                .contact-value { font-size: 0.82rem; white-space: nowrap; }
                .footer-grid { grid-template-columns: 1fr; gap: 2rem; }
                .about-card-main { min-height: 220px; overflow: hidden; }
                .about-badge {
                    width: 55px;
                    height: 55px;
                    right: 0.7rem;
                    bottom: 0.7rem;
                    border-width: 2px;
                    bottom: 0.7rem;
                    right: 0.7rem;
                }
                .about-badge span:first-child { font-size: 1.1rem; }
                .about-badge span:last-child { font-size: 0.38rem; max-width: 48px; }
            }
            @media (max-width: 768px) {
                /* Top bar más pequeña en mobile */
                .top-bar { font-size: 0.58rem; letter-spacing: 0.01em; }
                .top-bar-content { padding: 0.4rem 0.75rem; gap: 0.2rem; flex-wrap: nowrap; }
                .top-bar-left { gap: 0.6rem; flex-wrap: nowrap; }
                .top-bar-item { gap: 0.2rem; }

                /* Nav siempre visible en mobile — sin hide-on-scroll */
                nav {
                    top: 28px;
                }

                .nav-container {
                    padding: 0.5rem 0.6rem;
                    gap: 0.4rem;
                    overflow: hidden;
                }
                .logo {
                    font-size: 1rem;
                    flex-shrink: 0;
                }

                /* Nav menu: sin scroll, items se comprimen para caber */
                .nav-menu {
                    display: flex !important;
                    gap: 0;
                    flex-wrap: nowrap;
                    overflow: hidden;
                    flex: 1;
                    justify-content: flex-end;
                    align-items: center;
                }
                .nav-menu li a {
                    font-size: 0.6rem;
                    white-space: nowrap;
                    padding: 0 0.25rem;
                    letter-spacing: 0;
                }
                /* Galería, Proceso, Nosotros: visibles al inicio, se desvanecen al hacer scroll (JS) */
                /* Orden: 1-Cremación, 2-Galería, 3-Proceso, 4-Nosotros, 5-Contactar */
                .nav-menu li:nth-child(2),
                .nav-menu li:nth-child(3),
                .nav-menu li:nth-child(4) {
                    opacity: 1;
                    transition: opacity 0.5s ease;
                }
                .nav-menu li:nth-child(4) {
                    margin-left: -2px;
                }
                .nav-menu li:nth-child(2).nav-hidden,
                .nav-menu li:nth-child(3).nav-hidden,
                .nav-menu li:nth-child(4).nav-hidden {
                    opacity: 0;
                    pointer-events: none;
                }
                /* Botón Contactar siempre visible con margen derecho */
                .nav-menu .nav-cta {
                    padding: 0.28rem 0.65rem;
                    font-size: 0.6rem;
                    white-space: nowrap;
                    margin-left: 0.25rem;
                    flex-shrink: 0;
                }
            }

            /* Transicion extra suave del carrusel en celular */
            @media (max-width: 768px) {
                .carousel-slide { transition: opacity 2.4s cubic-bezier(0.4, 0, 0.2, 1); }
            }

            /* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
            BOTON CORAZON - solo visible en celular
            Flota fijo a la derecha durante todo el scroll
            Abre el menu lateral al hacer click
            ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
            .heart-btn {
                display: none;
            }
            @media (max-width: 768px) {
                .heart-btn {
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    position: fixed;
                    bottom: 2rem;
                    right: 1.2rem;
                    width: 48px;
                    height: 48px;
                    border-radius: 50%;
                    background: linear-gradient(145deg, #f9c6d8, #e8a0c0);
                    border: none;
                    cursor: pointer;
                    z-index: 9000;
                    box-shadow: 0 4px 18px rgba(220,130,170,0.35);
                    transition: transform 0.2s ease;
                }
                .heart-btn:active { transform: scale(0.92); }
                .heart-btn svg {
                    width: 22px;
